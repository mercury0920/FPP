import os
import numpy as np
from scipy.signal import hann
from scipy.io import loadmat, savemat
import matplotlib.pyplot as plt
import glob
import h5py
import numpy as np
import os
import scipy.io as savemat
# 定义参数
num_RRUs = 29
n = 30 # 汉宁窗的长度
Nk = 623 # 终端数
Nt = 4 # 天线数
Ng = 1632 # 延迟分辨率
Nc = 1632 # OFDM子载波数
dir_in = os.path.join('/opt/dpcvol/datasets/3232118373221765150/成万20251114/test')
dir_out = os.path.join('/opt/dpcvol/datasets/3232118373221765150/成万20251114_CFR/test_CFR')
# 创建输出目录
os.makedirs(dir_out, exist_ok=True)
def load_mat_file(file_path, key):
    try:
        with h5py.File(file_path, 'r') as file:
            data = file[key][:]
            return data
    except (OSError, KeyError) as e:
        print(f"无法加载文件 {file_path}: {e}")
        return None
# 预计算汉宁窗
win = np.hanning(2 * n + 1)
# 初始化CFR字典
CFR = {}
# 处理每个RRU
for i in range(1, num_RRUs + 1):
    RRU_dir = os.path.join(dir_in, f'RRU{i}')
    file_path = os.path.join(RRU_dir, 'Hcir.mat')
    key = 'Hcir'
   
    # 检查文件是否存在
    if not os.path.exists(file_path):
        print(f"文件 {file_path} 不存在")
        continue
   
    mat_data = load_mat_file(file_path, key)
    if mat_data is None:
        print(f"无法加载 {file_path} 中的 {key} 数据")
        continue
   
    Hcir = mat_data
    CFR[i] = np.zeros((Nt, Nk, Nc), dtype=np.complex64)
   
    for k in range(Nk):
        for n_ant in range(Nt):
            # 提取数值数据
            cir_real = Hcir[k, n_ant, :]['real'].astype(np.float32)
            cir_imag = Hcir[k, n_ant, :]['imag'].astype(np.float32)
           
            # 将实部和虚部组合成复数
            cir = cir_real + 1j * cir_imag
           
            # 找到绝对值最大的元素及其索引
            peak_val = np.max(np.abs(cir))
            peak_idx = np.argmax(np.abs(cir))
           
            start_idx = max(0, peak_idx - n)
            end_idx = min(len(cir) - 1, peak_idx + n)
           
            cir_win = cir[start_idx:end_idx + 1] * win[:end_idx - start_idx + 1]
           
            CFR[i][n_ant, k, :] = np.fft.fft(cir_win, Nc)
   
    print(f"RRU{i} 的 CFR 数据加载完成")
# 将字典中的CFR数据拼接成一个四维数组
CFR_combined = np.zeros((Nt, Nk, Nc, num_RRUs), dtype=np.complex64)
for i in range(1, num_RRUs + 1):
    if i in CFR:
        CFR_combined[:, :, :, i - 1] = CFR[i]
# 批量处理矩阵生成
for local_k1 in range(Nk):
    CFR_stack = CFR_combined[:, local_k1, :, :] # 获取当前子载波的CFR数据
   
    # 处理幅度
    CFR_img_amp = CFR_stack.reshape(Nt * num_RRUs, Nc)
    CFR_img_amp = np.abs(CFR_img_amp) # 取模
   
    # 归一化到[0, 1]
    CFR_img_amp = (CFR_img_amp - np.min(CFR_img_amp)) / (np.max(CFR_img_amp) - np.min(CFR_img_amp))
   
    # 处理相位图像
    CFR_img_phase = CFR_stack.reshape(Nt * num_RRUs, Nc)
    CFR_img_phase = np.angle(CFR_img_phase) # 取相位
   
    # 归一化到[0, 1]
    CFR_img_phase = (CFR_img_phase - np.min(CFR_img_phase)) / (np.max(CFR_img_phase) - np.min(CFR_img_phase))
   
    # 将幅度和相位数据拼接在一起
    CFR_img = np.concatenate((CFR_img_amp, CFR_img_phase), axis=0)
   
    # 保存为MAT文件
    ImgPath = os.path.join(dir_out, f'CFR{local_k1 + 1}.mat') # 注意MATLAB索引从1开始
    savemat.savemat(ImgPath, {'CFRImg': CFR_img})
    print(f'矩阵数据已保存到: {ImgPath}')
